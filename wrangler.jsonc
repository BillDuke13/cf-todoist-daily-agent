/**
 * Wrangler configuration: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Upload secrets (TODOIST_TOKEN, BASIC_AUTH_USER, BASIC_AUTH_PASS, FRONTEND_ORIGIN)
 * via `wrangler secret put` or `.dev.vars` locally; keep them out of `vars`.
 *
 * `DEBUG_EVENTS` defaults to `"false"` here and can be overridden per environment
 * via `wrangler secret put DEBUG_EVENTS true` (handled in `src/lib/cloudflare/env.ts`).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-todoist-daily-agent",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-04-09",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"ai": {
		"binding": "AI"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"DEBUG_EVENTS": "false",
		"AUTH_REALM": "Todoist Daily Agent"
	}
}
