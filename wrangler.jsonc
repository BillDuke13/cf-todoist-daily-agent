/**
 * Wrangler configuration. Reference:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Sensitive values (TODOIST_TOKEN, BASIC_AUTH_*, FRONTEND_ORIGIN) are uploaded
 * via `wrangler secret put` (production) or `.dev.vars` (local). They MUST NOT
 * be added to `vars` here.
 *
 * `DEBUG_EVENTS` is intentionally a `vars` default of `"false"`; flip it per
 * environment with `wrangler secret put DEBUG_EVENTS true` when triaging.
 * `cf-typegen` infers the literal `"false"` for it — see `isDebugEnabled` in
 * `src/app/api/plan/route.ts` for the runtime cast that handles overrides.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-todoist-daily-agent",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-04-09",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"ai": {
		"binding": "AI"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"DEBUG_EVENTS": "false"
	}
}
